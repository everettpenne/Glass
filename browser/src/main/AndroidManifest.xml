<?xml version="1.0" encoding="utf-8"?>
<!-- The browser asks for no permissions of its own: an app that opens web pages already holds INTERNET. It only needs to see whether
     Vanadium (and any browser) is installed, to offer "Open in Vanadium". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="app.vanadium.browser" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
